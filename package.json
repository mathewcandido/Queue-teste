{
  "name": "queue-test",
  "version": "1.0.0",
  "description": "trying to build an anotaai infra example",
  "main": "dist/server.js",
  "author": "Candido",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "relay": "tsx watch src/relay.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "swarm:build": "docker build -t queue-app:latest .",
    "swarm:init": "docker swarm init 2>/dev/null || true",
    "swarm:deploy": "docker stack deploy -c stack.yml queue",
    "swarm:migrate": "prisma migrate deploy",
    "swarm:scaler": "tsx scripts/autoscaler.ts",
    "swarm:ps": "docker stack services queue",
    "swarm:down": "docker stack rm queue"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bullmq": "^5.80.10",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.0",
    "prisma": "^6.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
