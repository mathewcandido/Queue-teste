generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Order {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  customer    String
  total       Decimal
  status      String
  processedBy String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, status])
}

// Transactional Outbox: o evento é gravado na MESMA transação do pedido.
// Um relay lê os PENDING e publica na fila — garante "salvou = vai processar".
model OutboxEvent {
  id          Int       @id @default(autoincrement())
  type        String
  payload     Json
  status      String    @default("PENDING") // PENDING -> PUBLISHING -> PUBLISHED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status])
}
